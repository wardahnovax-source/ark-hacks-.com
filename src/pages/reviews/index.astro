---
import PageLayout from '../../layouts/PageLayout.astro';
import { customerReviewStats, customerReviews, fillBrandTokens, productInfo, siteConfig } from '../../data/site';
import { brandCopy, brandSeo, seoPageTitle } from '../../data/site-core';
import { seoDescription } from '../../data/brand';
import { getReviewPath, reviewsBasePath } from '../../data/reviews';
import { arkImages } from '../../data/ark';

const title = seoPageTitle(brandSeo.reviewsTitle);
const description = seoDescription(brandSeo.reviewsDescription);
const reviewsIntro = fillBrandTokens(brandCopy.reviewsIntro);

function stars(rating: number): string {
	return '★'.repeat(rating) + '☆'.repeat(5 - rating);
}

const dateFormatter = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});

function formatDate(isoDate: string): string {
	return dateFormatter.format(new Date(`${isoDate}T00:00:00Z`));
}

const sortedReviews = [...customerReviews].sort((a, b) => (a.date < b.date ? 1 : -1));

const canonicalURL = new URL(reviewsBasePath, siteConfig.url).href;

const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'ItemList',
		'@id': `${canonicalURL}#list`,
		name: title,
		description,
		itemListElement: sortedReviews.map((review, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: new URL(getReviewPath(review.slug), siteConfig.url).href,
			name: review.seoTitle,
		})),
	},
];
---

<PageLayout
	title={title}
	description={description}
	canonicalPath={reviewsBasePath}
	heading={`${siteConfig.name} reviews`}
	intro={reviewsIntro}
	introEdit="reviewsIntro"
	eyebrow="Reviews"
	heroImage={arkImages.hero}
	heroAlt={fillBrandTokens('{brand} customer reviews')}
	showGallery={false}
	locale="en"
	extraGraph={extraGraph}
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: `Buy Now — $${productInfo.plans[0].price}`, edit: 'ctaBuy' }}
	ctaSecondary={{ href: '/pricing/', label: 'Compare pricing' }}
>
	<div class="reviews-index__summary" aria-label={`${customerReviewStats.averageRating} out of 5 average rating`}>
		<p class="reviews-index__avg">{customerReviewStats.averageRating.toFixed(1)}</p>
		<p class="reviews-index__avg-stars" aria-hidden="true">{stars(Math.round(customerReviewStats.averageRating))}</p>
		<p class="reviews-index__count">{customerReviewStats.totalCount} reviews · out of 5</p>
	</div>

	<div class="reviews-index__grid">
		{
			sortedReviews.map((review) => (
				<article class="reviews-index__card">
					<div class="reviews-index__card-top">
						<div class="reviews-index__who">
							<span class="reviews-index__avatar" aria-hidden="true">{review.handle.charAt(0).toUpperCase()}</span>
							<div>
								<p class="reviews-index__handle">@{review.handle}</p>
								<p class="reviews-index__date">
									<time datetime={review.date}>{formatDate(review.date)}</time>
								</p>
							</div>
						</div>
						<p class="reviews-index__stars" aria-label={`${review.rating} out of 5 stars`}>
							{stars(review.rating)}
						</p>
					</div>
					{review.tag ? <p class="reviews-index__tag">{review.tag}</p> : null}
					<p class="reviews-index__text">{review.text}</p>
					<a class="reviews-index__more" href={getReviewPath(review.slug)}>
						Read full review
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M5 12h14m-6-6l6 6-6 6"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</a>
				</article>
			))
		}
	</div>
</PageLayout>

<style>
	.reviews-index__summary {
		display: grid;
		gap: 0.15rem;
		justify-items: start;
		text-align: left;
		margin-bottom: 1.35rem;
		padding: 0.85rem 1.1rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-panel);
		width: fit-content;
		max-width: 100%;
	}

	.reviews-index__avg {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.85rem;
		font-weight: 800;
		line-height: 1;
		color: var(--magenta-soft);
	}

	.reviews-index__avg-stars {
		margin: 0;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		color: var(--accent-amber);
	}

	.reviews-index__count {
		margin: 0;
		font-size: 0.78rem;
		color: var(--ink-faint);
	}

	.reviews-index__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.reviews-index__card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.05rem 1.1rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-panel);
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.reviews-index__card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		transform: translateY(-2px);
	}

	.reviews-index__card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.reviews-index__who {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}

	.reviews-index__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		background: var(--bg-elevated);
		color: var(--magenta-soft);
		font-size: 0.9rem;
		font-weight: 800;
	}

	.reviews-index__handle {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.reviews-index__date {
		margin: 0.1rem 0 0;
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.reviews-index__stars {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		color: var(--accent-amber);
		white-space: nowrap;
	}

	.reviews-index__tag {
		margin: 0;
		display: inline-flex;
		align-self: start;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		background: var(--bg);
		color: var(--magenta-soft);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.reviews-index__text {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.92rem;
		line-height: 1.6;
		flex-grow: 1;
	}

	.reviews-index__more {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--magenta-soft);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.reviews-index__more:hover {
		color: var(--ink);
	}

	@media (max-width: 680px) {
		.reviews-index__grid {
			grid-template-columns: 1fr;
		}

		.reviews-index__summary {
			width: 100%;
		}
	}
</style>
